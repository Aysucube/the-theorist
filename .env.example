# Copy to .env.local for local development, or set in your host's settings.

# Your deployed site's URL. Added to the User-Agent on requests to Scryfall,
# EDHREC and TCGph so they can see who is calling. Recommended in production.
APP_URL=

# Where to read the shared daily price-trends file (built by
# .github/workflows/market-trends.yml). Leave empty to use this repository's
# trends-data branch; set it for a fork or a separate public data repository.
TRENDS_URL=
